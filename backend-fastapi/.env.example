# ArtisanLoft Backend — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit real secrets to git.

# Database — Supabase Postgres asyncpg connection string (use the pooler URL in production)
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Supabase Auth — Used for JWT signature verification via JWKS
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# JWT Authentication
JWT_SECRET=<random-secret-min-32-chars>
JWT_EXPIRE_MINUTES=60

# CORS — Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000

# Application & Deployment
FRONTEND_URL=http://localhost:3000
# NOTE: ENV=production is MANDATORY in deployment (Render), otherwise localhost:3000 is added to CORS.
ENV=development
PORT=8000

# Redis rate limiting
# Set REDIS_URL in Render to an Upstash rediss:// connection URL.
# Leave this blank in local development and tests to use the process local fallback.
# If Redis is down or slow, requests continue and a warning is logged (fail open).
REDIS_URL=

# External Integrations (Optional)
UNSPLASH_ACCESS_KEY=<unsplash-access-key>
